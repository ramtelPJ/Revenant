# For `next dev` only. `npm run revenant` generates both secrets itself.
# Never commit real values. Copy to .env.local and fill in.
REVENANT_LAUNCH_TOKEN=your-random-64-hex-chars-here
REVENANT_SESSION_SECRET=your-different-random-64-hex-chars-here
HOST=127.0.0.1
PORT=3000
OLLAMA_URL=http://127.0.0.1:11434
# Chosen in MODEL-001: qwen2.5-coder:3b (about 1.9 GB; `ollama pull qwen2.5-coder:3b` once, needs internet).
# It wrote valid patches and repaired the simplest broken sample; gemma2:2b (SPIKE-002) did neither. See build-plan.md.
OLLAMA_MODEL=qwen2.5-coder:3b
SANDBOX_IMAGE=node:lts-slim
DATA_DIR=./data

# Optional limits (defaults shown)
# AI_TIMEOUT_SEC=120
# SANDBOX_MEMORY_MB=512
# SANDBOX_CPUS=1
# CHECK_TIMEOUT_SEC=120
# MAX_ARCHIVE_MB=100
# MAX_PROJECT_MB=300
